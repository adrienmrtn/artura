default_platform(:ios)

platform :ios do
  desc "Envoie nom, sous-titre, texte promotionnel, description, mots-clés et nouveautés (toutes les langues) vers App Store Connect"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.vikstudios.artura",
      app_version: ENV.fetch("APP_VERSION", "2.1"),
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Envoie les captures de fastlane/screenshots (toutes les langues) vers App Store Connect"
  lane :screenshots do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.vikstudios.artura",
      app_version: ENV.fetch("APP_VERSION", "2.1"),
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      skip_app_version_update: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Envoie seulement le nom de l'app (name.txt) pour toutes les langues"
  lane :app_name do
    require "tmpdir"
    require "fileutils"
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false
    )

    # Dossier temporaire avec uniquement name.txt : deliver n'envoie que ce qui existe.
    only_names = Dir.mktmpdir("artura-names")
    # Chemin absolu : le dossier de travail d'une lane n'est pas forcément la racine du dépôt.
    names = Dir.glob(File.join(File.expand_path(FastlaneCore::FastlaneFolder.path), "metadata", "*", "name.txt"))
    UI.user_error!("Aucun name.txt trouvé dans fastlane/metadata") if names.empty?
    names.each do |f|
      locale = File.basename(File.dirname(f))
      FileUtils.mkdir_p(File.join(only_names, locale))
      FileUtils.cp(f, File.join(only_names, locale, "name.txt"))
    end
    UI.message("#{names.size} noms à envoyer : " + names.map { |f| File.basename(File.dirname(f)) }.sort.join(", "))

    deliver(
      api_key: api_key,
      app_identifier: "com.vikstudios.artura",
      app_version: ENV.fetch("APP_VERSION", "2.1"),
      metadata_path: only_names,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Captures anglais (en-US) : iPhone 6,9 pouces + iPad 13 pouces, depuis fastlane/screenshots_en"
  lane :screenshots_en do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false
    )

    # Chemin absolu : le dossier de travail d'une lane est fastlane/, pas la racine du dépôt.
    path = File.join(File.expand_path(FastlaneCore::FastlaneFolder.path), "screenshots_en")
    files = Dir.glob(File.join(path, "en-US", "*.jpg"))
    UI.user_error!("Aucune capture trouvée dans #{path}/en-US") if files.empty?
    UI.message("#{files.size} captures à envoyer : " + files.map { |f| File.basename(f) }.sort.join(", "))

    # overwrite_screenshots remplace TOUTES les captures de la langue envoyée (iPhone et iPad) :
    # c'est pourquoi le dossier contient les deux. Les autres langues ne sont pas touchées.
    deliver(
      api_key: api_key,
      app_identifier: "com.vikstudios.artura",
      app_version: ENV.fetch("APP_VERSION", "2.1"),
      screenshots_path: path,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      skip_app_version_update: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end
