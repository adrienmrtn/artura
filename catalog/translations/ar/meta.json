 "movements": {
  "antiquity": {
   "name": "العالم القديم",
   "period": "2600 ق.م-300 م",
   "summary": "آلهة وملوك وجسد مثالي",
   "description": "من مصر إلى اليونان وروما، ينحت الفنانون الملوك والآلهة والرياضيين لتبقى تماثيلهم إلى الأبد. وصار بحثهم عن الجسد المثالي نموذجًا للفن الغربي طوال قرون."
  },
  "gothic": {
   "name": "الفن القوطي وما قبل النهضة",
   "period": "1280-1430",
   "summary": "خلفيات ذهبية وأولى المشاعر الحقيقية",
   "description": "في الكنائس والمصليات ما زال الرسامون يعملون على أرضية من الذهب، لكن شخصياتهم تبدأ بالبكاء والالتفات وتكتسب وزنًا. وهكذا يُعاد اختراع رواية القصص بالصور."
  },
  "early_netherlandish": {
   "name": "الفن الفلمنكي المبكر",
   "period": "1420-1500",
   "summary": "ألوان زيتية وتفاصيل مبهرة",
   "description": "في فلاندرز أتقن الرسامون الألوان الزيتية، فراحوا يصفون بها كل شيء: الفرو والزجاج والدمعة والانعكاس. وتنتقل المشاهد المقدسة إلى غرف تشبه البيوت الحقيقية."
  },
  "renaissance": {
   "name": "النهضة الإيطالية",
   "period": "1420-1570",
   "summary": "المنظور والعودة إلى العصور القديمة",
   "description": "في إيطاليا ثم في أنحاء أوروبا، يكتشف الفنانون العصور القديمة من جديد، ويدرسون جسد الإنسان، ويبتكرون المنظور. وتصبح اللوحة نافذة مفتوحة على العالم."
  },
  "northern_renaissance": {
   "name": "نهضة الشمال",
   "period": "1490-1570",
   "summary": "خطوط حادة ومطبوعات ورؤى غريبة",
   "description": "شمال جبال الألب يمزج الفنانون الأفكار الإيطالية بحبهم للتفاصيل والحياة اليومية. وتنشر الطباعة صورهم في أرجاء أوروبا."
  },
  "mannerism": {
   "name": "المانييرية",
   "period": "1520-1610",
   "summary": "أناقة مشدودة إلى أقصى حد",
   "description": "بعد الأساتذة الكبار يلوي الرسامون القواعد عن قصد: أجساد طويلة، وأوضاع ملتوية، وألوان حادة. ويصبح الأسلوب نفسه هو الموضوع."
  },
  "baroque": {
   "name": "الباروك",
   "period": "1600-1700",
   "summary": "دراما وحركة وظلال عميقة",
   "description": "يسعى الفن إلى تحريك مشاعر المشاهد. تباين قوي بين النور والظلمة، وأجساد في حركة، وإخراج مسرحي يسحبك إلى قلب المشهد."
  },
  "siecledor": {
   "name": "العصر الذهبي الهولندي",
   "period": "1600-1700",
   "summary": "الحياة اليومية والضوء",
   "description": "في الجمهورية الهولندية المزدهرة يرسم الفنانون لبيوت الطبقة الوسطى: غرف هادئة وصور شخصية وطبيعة صامتة. ويصبح الضوء هو بطل اللوحة الحقيقي."
  },
  "rococo": {
   "name": "الروكوكو وقرن الثامن عشر",
   "period": "1715-1790",
   "summary": "خفة ومتعة وألوان باستيل",
   "description": "في صالونات القرن الثامن عشر تصبح الرسوم مرحة وحميمة: حفلات في الحدائق وصور شخصية وألوان ناعمة. وفي الوقت نفسه ينظر بعض الفنانين بهدوء إلى حياة الناس العاديين."
  },
  "neoclassicism": {
   "name": "الكلاسيكية الجديدة",
   "period": "1760-1860",
   "summary": "خطوط واضحة وفضيلة قديمة",
   "description": "بوحي من أطلال روما وبومبي، يعود الفنانون إلى رسم رصين وموضوعات بطولية. فالرسم عندهم يعلّم بقدر ما يُمتع."
  },
  "romanticism": {
   "name": "الرومانسية",
   "period": "1780-1860",
   "summary": "العاطفة والطبيعة والجلال",
   "description": "تتقدم المشاعر على العقل. عواصف وأطلال وثورات وشخصيات وحيدة تعبّر عمّا يشعر به الفنان أمام عالم أكبر من أن يُحتوى."
  },
  "ukiyoe": {
   "name": "أوكيو-إيه",
   "period": "1680-1860",
   "summary": "مطبوعات «العالم العائم»",
   "description": "في اليابان تصوّر المطبوعات الخشبية، التي تصدر في سلاسل، الممثلين والمناظر الطبيعية ومشاهد الحياة اليومية. وستهز ألوانها المسطحة وقصّاتها الجريئة الرسامين الأوروبيين."
  },
  "east_asian": {
   "name": "الرسم الصيني والياباني",
   "period": "750-1720",
   "summary": "حبر وحرير وفراغ",
   "description": "في الصين واليابان يعمل الرسامون بالفرشاة والحبر على الحرير والورق والستائر المطوية. وتكفي بضع ضربات ومساحة واسعة من الفراغ لتوحي بجبل أو بفصل من فصول السنة."
  },
  "realism": {
   "name": "الواقعية",
   "period": "1845-1890",
   "summary": "الناس العاديون كما هم",
   "description": "يبتعد الرسامون عن الأبطال والأساطير ليصوروا الفلاحين والعمال والحياة الحديثة دون تجميل. ويصبح قول الحقيقة موقفًا بحد ذاته."
  },
  "american": {
   "name": "الرسم الأمريكي",
   "period": "1780-1930",
   "summary": "بلد جديد ينظر إلى نفسه",
   "description": "من صور الجمهورية الفتية إلى المناظر الطبيعية الشاسعة ومشاهد حياة المدن، يبحث الرسامون الأمريكيون عن موضوعاتهم الخاصة وعن ضوء يخصهم."
  },
  "preraphaelite": {
   "name": "ما قبل الرافائيلية والعصر الفيكتوري",
   "period": "1848-1900",
   "summary": "ألوان زاهية وأساطير وتفاصيل",
   "description": "في بريطانيا الفيكتورية ترفض مجموعة من الرسامين الشباب وصفات الأكاديمية. فيرسمون الأساطير والقصائد بألوان قوية ودقة تكاد تكون هوسًا."
  },
  "academic": {
   "name": "الفن الأكاديمي",
   "period": "1830-1900",
   "summary": "فن الصالون الرسمي المصقول",
   "description": "تدرب هؤلاء الرسامون في كبريات مدارس الفن، فأتقنوا التشريح والتاريخ وسطحًا ناعمًا بلا عيب. كانوا نجوم زمانهم قبل أن تحجبهم طلائع الحداثة."
  },
  "impressionnisme": {
   "name": "الانطباعية",
   "period": "1867-1910",
   "summary": "رسم ضوء اللحظة",
   "description": "تترك مجموعة من الرسامين المرسم لتعمل في الهواء الطلق بضربات فرشاة سريعة وصغيرة. لم يعد همهم التفاصيل، بل أثر الضوء في لحظة بعينها."
  },
  "neo_impressionism": {
   "name": "الانطباعية الجديدة",
   "period": "1884-1910",
   "summary": "اللون نقطة بعد نقطة",
   "description": "يطبّق الرسامون العلم على اللون: نقاط صغيرة من الطلاء الخالص متجاورة تمتزج في عين المشاهد. وتُبنى اللوحة ببطء كما يُبنى الفسيفساء."
  },
  "postimp": {
   "name": "ما بعد الانطباعية",
   "period": "1885-1910",
   "summary": "اللون والعاطفة أولًا",
   "description": "بعد الانطباعية يبحث كل فنان عن طريقه. لم يعد اللون يحاكي الواقع، بل صار يعبّر عمّا يشعر به الرسام."
  },
  "symbolism": {
   "name": "الرمزية",
   "period": "1860-1915",
   "summary": "أحلام وأساطير وعوالم داخلية",
   "description": "بدل وصف العالم المرئي يوحي هؤلاء الفنانون بالأفكار والأحلام والمخاوف. وهي لوحات تُحَسّ قبل أن تُفهم."
  },
  "secession": {
   "name": "الفن الحديث وانفصال فيينا",
   "period": "1890-1918",
   "summary": "ذهب وزخرفة وخطوط منحنية",
   "description": "في فيينا ينفصل الفنانون الشباب عن الأكاديمية. يمزجون الرسم بالزخرفة والحرفة، ويحوّلون الزخرفة إلى لغة قائمة بذاتها."
  },
  "fauvism": {
   "name": "الوحشية",
   "period": "1904-1917",
   "summary": "ألوان خالصة مباشرة من الأنبوب",
   "description": "في سنوات قليلة متفجرة استخدم الرسامون ألوانًا عنيفة غير طبيعية وضربات فرشاة حرة. ووصفهم النقاد بالوحوش، وبقي الاسم."
  },
  "expressionism": {
   "name": "التعبيرية",
   "period": "1903-1925",
   "summary": "أشكال مشوهة ومشاعر خام",
   "description": "يلوي الفنانون الأشكال ويشتدون في الألوان ليعبّروا عن القلق والرغبة والتمرد. المهم ليس شكل العالم، بل إحساسنا به."
  },
  "cubism": {
   "name": "التكعيبية",
   "period": "1909-1925",
   "summary": "أشياء مرئية من عدة جهات في آن واحد",
   "description": "يفكك الرسامون الأشياء إلى أوجه ويعرضونها من زوايا عدة في اللوحة الواحدة. وفجأة توضع خمسة قرون من المنظور موضع تساؤل."
  },
  "futurism": {
   "name": "المستقبلية",
   "period": "1909-1920",
   "summary": "السرعة والآلات والمدينة الحديثة",
   "description": "يحتفي الفنانون الإيطاليون بالسيارات والحشود والكهرباء. ويحاولون رسم الحركة نفسها بتكرار الأشكال وتفتيتها."
  },
  "abstraction": {
   "name": "التجريد وطلائع الحداثة",
   "period": "1907-1930",
   "summary": "رسم بلا موضوع",
   "description": "لم تعد الخطوط والأشكال والألوان تمثل شيئًا: صارت هي اللوحة. ويبحث الفنانون عن لغة بصرية مباشرة كالموسيقى."
  },
  "dada_surrealism": {
   "name": "الدادائية وبدايات السريالية",
   "period": "1912-1930",
   "summary": "صدفة وعبث وأحلام",
   "description": "وُلدت الدادائية من اشمئزاز الحرب العالمية الأولى، فسخرت من الفن نفسه. ثم جاءت السريالية لتستكشف الأحلام والصدفة واللاوعي."
  },
  "world": {
   "name": "أفريقيا وآسيا والأمريكتان",
   "period": "1200 ق.م-1600",
   "summary": "أشياء مقدسة وفن البلاطات",
   "description": "برونزيات وأقنعة وعمالقة حجرية وأدوات طقسية من أفريقيا وآسيا والأمريكتين. صُنعت للاحتفالات والمعابد والملوك، قبل زمن طويل من ظهور المتاحف."
  }
